FROM debian:trixie
LABEL maintainer="ntop Packager <packager@ntop.org>"

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && \
    apt-get -y -q install lsb-release wget gnupg apt-transport-https whiptail ca-certificates && \
    wget -q https://packages.ntop.org/apt-stable/trixie/all/apt-ntop-stable.deb && \
    dpkg -i apt-ntop-stable.deb && \
    apt-get clean all

RUN apt-get update && \
    apt-get -y install pfring

RUN echo '#!/bin/bash\nset -e\nexec "$@" $NTOP_CONFIG' > /run.sh && \
    chmod +x /run.sh

ENTRYPOINT ["/run.sh"]

