FROM debian:trixie
LABEL maintainer="ntop Packager <packager@ntop.org>"

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && \
    apt-get -y -q install lsb-release wget gnupg apt-transport-https whiptail ca-certificates && \
    wget -q https://packages.ntop.org/apt/trixie/all/apt-ntop.deb && \
    dpkg -i apt-ntop.deb && \
    apt-get clean all

RUN apt-get update && \
    echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections && \
    apt-get -y install ntap
    
RUN echo '#!/bin/bash\nntap_remote "$@" $NTOP_CONFIG' > /run.sh && \
    chmod +x /run.sh

ENTRYPOINT ["/run.sh"]
