FROM debian:trixie
LABEL maintainer="ntop Packager <packager@ntop.org>"

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && \
    apt-get -y -q install lsb-release wget gnupg apt-transport-https ca-certificates whiptail && \
    wget -q https://packages.ntop.org/apt/trixie/all/apt-ntop.deb && \
    dpkg -i apt-ntop.deb && \
    apt-get clean all

RUN apt-get update && \
    apt-get -y install nprobe

RUN echo '#!/bin/bash\nnprobe "$@" $NTOP_CONFIG' > /run.sh && \
    chmod +x /run.sh

ENTRYPOINT ["/run.sh"]
